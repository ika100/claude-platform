{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(gh repo create * --private *)",
      "Bash(gh repo edit * --add-topic *)",
      "Bash(gh api user *)",
      "Bash(gh api user)",
      "Bash(git clone --depth 1 *)",
      "Bash(uv tool install copier)",
      "Bash(uv run * shapes.py *)",
      "Bash(mktemp -d)",
      "Bash(copier copy *)",
      "Bash(copier update *)",
      "Bash(copier --version)"
    ],
    "ask": [
      "Bash(gh repo create * --public *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit * --remove-topic *)"
    ]
  }
}
