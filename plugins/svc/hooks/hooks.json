{
  "$schema": "https://json.schemastore.org/claude-code-hooks.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "devbox run -- uv sync --all-extras >/dev/null 2>&1 || true",
            "timeout": 60,
            "statusMessage": "Syncing devbox + uv dev environment"
          }
        ]
      }
    ]
  }
}
