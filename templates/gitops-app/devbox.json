{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "uv@latest",
    "kustomize@latest",
    "kubeconform@latest",
    "kubectl@latest",
    "detect-secrets@latest",
    "jq@latest",
    "git@latest",
    "gh@latest"
  ],
  "shell": {
    "scripts": {
      "render":       "uv run scripts/render.py",
      "render-check": "uv run scripts/render.py --check",
      "validate":     "uv run scripts/render.py --check && for d in applications/*/overlays/*/*/; do [ -f \"$d/kustomization.yaml\" ] || continue; echo \"kustomize build $d\"; kustomize build \"$d\" > /dev/null || exit 1; done; for f in applications/*/applicationset.yaml; do kubeconform -strict -ignore-missing-schemas -summary \"$f\" || exit 1; done",
      "lint":         "devbox run validate",
      "lint-fix":     "devbox run render",
      "quality":      "devbox run lint",
      "test":         "devbox run validate",
      "test-fast":    "uv run scripts/render.py --check",
      "secrets-scan": "git ls-files -z | xargs -0 detect-secrets-hook --baseline .secrets.baseline.json",
      "security":     "devbox run secrets-scan",
      "deploy-check": "devbox run validate"
    }
  }
}
