package {{ package_name }};

import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
{%- if needs_observability %}
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
{%- endif %}
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;

import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
{%- if needs_observability %}
import org.springframework.boot.test.autoconfigure.actuate.observability.AutoConfigureObservability;
{%- endif %}
import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
import org.springframework.boot.test.context.SpringBootTest;
{%- if needs_database %}
import org.springframework.context.annotation.Import;
{%- endif %}
import org.springframework.test.web.servlet.MockMvc;

@SpringBootTest
@AutoConfigureMockMvc
{%- if needs_database %}
@Import(TestcontainersConfiguration.class)
{%- endif %}
{%- if needs_observability %}
// Test slices disable metric exporters by default; enable them to scrape /actuator/prometheus.
@AutoConfigureObservability
{%- endif %}
class ApplicationTests {

  @Autowired private MockMvc mvc;

  @Test
  void livenessProbeIsUp() throws Exception {
    mvc.perform(get("/actuator/health/liveness"))
        .andExpect(status().isOk())
        .andExpect(jsonPath("$.status").value("UP"));
  }

  @Test
  void readinessProbeIsUp() throws Exception {
    mvc.perform(get("/actuator/health/readiness"))
        .andExpect(status().isOk())
        .andExpect(jsonPath("$.status").value("UP"));
  }

  @Test
  void infoEndpointReturnsServiceName() throws Exception {
    mvc.perform(get("/api/info"))
        .andExpect(status().isOk())
        .andExpect(jsonPath("$.service").value("{{ project_name }}"));
  }
{%- if needs_observability %}

  @Test
  void prometheusEndpointExposesMetrics() throws Exception {
    mvc.perform(get("/actuator/prometheus"))
        .andExpect(status().isOk())
        .andExpect(content().string(org.hamcrest.Matchers.containsString("jvm_memory_used_bytes")));
  }
{%- endif %}
}
