# syntax=docker/dockerfile:1.7

FROM --platform=$BUILDPLATFORM golang:{{ go_version }} AS builder
WORKDIR /src

COPY go.mod go.sum* ./
RUN go mod download

COPY . .
# VERSION is the git tag (v1.2.3) in CI, "dev" locally; injected via ldflags (ADR-012).
ARG VERSION=dev
ARG TARGETOS
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath \
    -ldflags "-s -w -X main.Version=${VERSION}" \
    -o /out/{{ project_name }} ./cmd/{{ project_name }}


FROM gcr.io/distroless/static-debian12:nonroot AS runtime
# Links the GHCR package to this repository, so CI's GITHUB_TOKEN can push to it (no manual "Manage Actions access" step).
LABEL org.opencontainers.image.source="https://github.com/{{ github_org }}/{{ project_name }}" \
      org.opencontainers.image.description="{{ description | replace('"', '') | replace('\\', '') }}"

COPY --from=builder /out/{{ project_name }} /{{ project_name }}

ENV PORT={{ port }}
# Numeric UID: Kubernetes cannot verify runAsNonRoot for a named user. 65532 is the distroless "nonroot" user.
USER 65532:65532
EXPOSE {{ port }}

# distroless has no shell: liveness/readiness are handled by the Kubernetes probes on /health and /ready.
ENTRYPOINT ["/{{ project_name }}"]
