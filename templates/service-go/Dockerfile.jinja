# syntax=docker/dockerfile:1.7

FROM golang:{{ go_version }} AS builder
WORKDIR /src

COPY go.mod go.sum* ./
RUN go mod download

COPY . .
# VERSION is the git tag (v1.2.3) in CI, "dev" locally; injected via ldflags (ADR-012).
ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath \
    -ldflags "-s -w -X main.Version=${VERSION}" \
    -o /out/{{ project_name }} ./cmd/{{ project_name }}


FROM gcr.io/distroless/static-debian12:nonroot AS runtime

COPY --from=builder /out/{{ project_name }} /{{ project_name }}

ENV PORT={{ port }}
USER nonroot:nonroot
EXPOSE {{ port }}

# distroless has no shell: liveness/readiness are handled by the Kubernetes probes on /health and /ready.
ENTRYPOINT ["/{{ project_name }}"]
