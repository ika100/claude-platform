{
  "name": "{{ project_name }}",
  "version": "0.1.0",
  "private": true,
  "description": "{{ description }}",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">={{ node_major }}"
  },
  "scripts": {
    "dev": "next dev --port {{ port }}",
    "build": "next build",
    "start": "next start --port {{ port }}",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:fast": "vitest run"{% if needs_e2e %},
    "e2e": "playwright test"{% endif %}
  },
  "dependencies": {
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"{% if needs_observability %},
    "@opentelemetry/api": "^1.9.1",
    "@vercel/otel": "^2.1.3",
    "prom-client": "^15.1.3"{% endif %}
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^{{ node_major }}",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.0",
    "jsdom": "^30.1.2",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"{% if needs_e2e %},
    "@playwright/test": "^1.63.0"{% endif %}
  }
}
